# US WIN HUNTER — Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=us-win-hunter
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string-in-production

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for local dev without Docker). Leave unset to use <repo>/data/winhunter.db
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/data/winhunter.db

# PostgreSQL (production / Docker)
# DATABASE_URL=postgresql+asyncpg://winhunter:winhunter@localhost:5432/winhunter

# =============================================================================
# META AD LIBRARY API
# =============================================================================
# Requires a Facebook App with ads_read permission
# https://developers.facebook.com/docs/marketing-api/reference/ad-library/
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# =============================================================================
# REDDIT API
# =============================================================================
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=USWinHunter/1.0

# =============================================================================
# APIFY (Fail-Closed Budget & T+14 Freeze Safeguards)
# =============================================================================
APIFY_API_TOKEN=
APIFY_AUTO_COLLECTION_ENABLED=false
APIFY_DAILY_BUDGET_USD=5.0
APIFY_MONTHLY_BUDGET_USD=50.0
APIFY_MAX_ADS_PER_QUERY=100

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Options: openai, google, anthropic, local
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# =============================================================================
# COLLECTION SETTINGS
# =============================================================================
# Maximum concurrent collection jobs
MAX_CONCURRENT_JOBS=3
# Default collection interval in minutes
DEFAULT_COLLECTION_INTERVAL_MINUTES=360
# Rate limit: max requests per minute per source
DEFAULT_RATE_LIMIT_RPM=30

# =============================================================================
# SCORING WEIGHTS (initial heuristics, tunable)
# =============================================================================
# Emergence Score weights (must sum to 1.0)
EMERGENCE_W_ADVERTISER_ACCEL=0.30
EMERGENCE_W_CREATIVE_ACCEL=0.25
EMERGENCE_W_AD_PERSISTENCE=0.20
EMERGENCE_W_SIGNAL_RECENCY=0.15
EMERGENCE_W_DEMAND_CONFIRM=0.10

# Evidence Confidence weights (must sum to 1.0)
CONFIDENCE_W_COVERAGE=0.30
CONFIDENCE_W_INDEPENDENT_SOURCES=0.25
CONFIDENCE_W_PRODUCT_IDENTITY=0.20
CONFIDENCE_W_ADVERTISER_INDEPENDENCE=0.15
CONFIDENCE_W_EVIDENCE_LINKS=0.10

# Bundle Potential weights (must sum to 1.0)
BUNDLE_W_MULTI_UNIT_NECESSITY=0.30
BUNDLE_W_FUNCTIONAL_BENEFIT=0.25
BUNDLE_W_AOV_FIT=0.20
BUNDLE_W_USAGE_FREQUENCY=0.15
BUNDLE_W_DECISION_SIMPLICITY=0.10

